+/* Called only with an awake CPU, no accepted interrupt, one instruction per
+ * quantum and at least one already-proven transition-free peripheral tick.
+ * Do not prefetch or decode a later instruction before its tick: page faults,
+ * live descriptors and side-effecting fetches retain the ordinary ordering.
+ * A complex instruction executes normally, then returns to the outer loop
+ * before any possible interrupt/mode/sleep/clock change is used again. */
+uint32_t o_cpu_run_quiet(orchard_machine *m, uint32_t budget) {
+    uint32_t done = 0;
+    do {
+        --m->quiet_left;
+        ++m->deferred_ticks;
+        ++m->ticks;
+        ++done;
+        if (!cpu_step(m, true)) break;
+    } while (done < budget && m->quiet_left);
+    return done;
 }
 
 void o_cpu_step_reference(orchard_machine *m) { cpu_step(m, false); }
