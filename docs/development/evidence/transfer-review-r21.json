  "reviewed_invariants": {
    "note": [
      "ASCII Note escapes are decoded once into raw calculator bytes; binary input is returned unchanged.",
      "Saturn string size includes its own five nibbles and is bounded to 0xfffff; source input is unchanged.",
      "Leading whitespace and CRLF handling remain the deliberately witnessed stock semantics, with lone CR/LFCR and unknown escapes preserved.",
      "Controller stores converted bytes and their actual length; a protocol retry reuses them, while a failed file read is retried and total size is checked again."
    ],
    "ack": [
      "HP39 alone opts into receiver ACK repetition; the generic HP48/49 default is unchanged.",
      "The receiver retry deadline starts only after the whole ACK has been accepted by the transport.",
      "Unsent obsolete ACKs are removed; partially transmitted frames finish before following frames so packets are not interleaved.",
      "Duplicate data is acknowledged without appending it twice; completed files are committed once after the final ACK is sent.",
      "Final ACK retries keep the existing grace expiry and bounded retries; a new command clears a pending unsent final ACK.",
      "Cancellation, total virtual-time limits and request/generation isolation remain effective."
    ],
    "localization": [
      "Error code and interpolation values survive protocol, Worker, controller and per-file queue transitions.",
      "Retry, skip, new-file and unknown-error transitions clear an earlier translated error code.",
      "Known failures have bilingual primary text; unknown technical diagnostics use the localized fallback and collapsed original details."
    ]
  },
