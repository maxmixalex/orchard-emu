+/* Keep the full rollback transaction out of the per-instruction hot frame.
+ * Its state copy and abort/diagnostic behavior are identical to the reference
+ * dispatcher; ordinary ARM operations do not need to allocate that frame. */
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((noinline))
+#endif
+static void cpu_checkpointed(orchard_machine *m, uint32_t instruction, unsigned width, uint32_t pc) {
+    o_cpu *c = &m->cpu;
+    o_cpu before = *c;
+    c->next_pc = pc + width;
+    if (width == 2) o_thumb(m, (uint16_t)instruction);
+    else arm(m, instruction);
+    if (m->stop.status != ORCHARD_OK) {
+        m->stop.instruction = instruction;
+        *c = before;
+        return;
+    }
+    if (c->data_abort) {
+        uint32_t far = c->far, fsr = c->dfsr;
+        *c = before;
+        c->far = far;
+        c->dfsr = fsr;
+        o_exception(c, O_ABT, 0x10, pc + 8u);
+    } else c->r[15] = c->next_pc;
+    ++c->instructions;
+}
 static void cpu_step(orchard_machine *m, bool fast) {
     o_cpu *c = &m->cpu;
     uint32_t pc = c->r[15], physical = 0, instruction = 0;
